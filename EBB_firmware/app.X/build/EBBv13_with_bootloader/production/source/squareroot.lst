                      00100 ;;;MSB  equ 7               ; general literal constants
                      00101 ;;;LSB  equ 0
                      00102 ;;;W    equ 0
                      00103 ;;;F    equ 1
                      00104 ;;;a    equ 0
                      00105 ; *******************************************************************
                      00106 ; *******************************************************************
                      00107 sqrtVar UDATA   0x500               ; allocate RAM in grp5 section
000500                00108 ARGA0   res 1                       ; various argument registers
000501                00109 ARGA1   res 1
000502                00110 ARGA2   res 1
000503                00111 ARGA3   res 1
  0000                00112     GLOBAL ARGA0, ARGA1, ARGA2, ARGA3
000504                00113 ARG1H   res 1
000505                00114 ARG1L   res 1
000506                00115 ARG2H   res 1
000507                00116 ARG2L   res 1
  0000                00117     GLOBAL ARG1H, ARG1L, ARG2H, ARG2L
000508                00118 SARG1   res 1                       ; signed arguments
000509                00119 SARG2   res 1
  0000                00120     GLOBAL SARG1, SARG2
00050A                00121 RES1    res 1                       ; result registers
00050B                00122 RES0    res 1
  0000                00123     GLOBAL RES0, RES1
00050C                00124 SQRES0  res 1
00050D                00125 SQRES1  res 1
00050E                00126 SQRES2  res 1
00050F                00127 SQRES3  res 1
  0000                00128     GLOBAL SQRES0, SQRES1, SQRES2, SQRES3
000510                00129 BITLOC0 res 1                       ; temporary registers
000511                00130 BITLOC1 res 1
000512                00131 TEMP0   res 1
000513                00132 TEMP1   res 1
                      00133 ; *******************************************************************
                      00134 ; *******************************************************************
                      00135 ; The function of this square root routine is to determine the root
                      00136 ; to the nearest integer. At the same time the root is found at the
                      00137 ; best possible speed; therefore, the root is found a little differently
                      00138 ; for the two basic sizes of numbers, 16-bit and 32-bit. The following
                      00139 ; differentiates the two and jumps to the appropriate function.
                      00140 ; Sqrt(ARGA3:ARGA2:ARGA1:ARGA0) = PRODH:PRODL
                      00141         CODE
000000                00142 Sqrt    
000000 CFD9 FFE6      00143         movff   0xfd9, 0xfe6
000004 CFE1 FFD9      00144         movff   0xfe1, 0xfd9
000008 0105           00145         movlb   5                   ; All our RAM is in bank 5
00000A 0EFB           00146         movlw   0xFB                ; load -1 into W
00000C CFDB F???      00147         movff   PLUSW2, ARGA0       ; And offset FSR1 by W and store in ARGA3 
000010 0EFC           00148         movlw   0xFC                ; load -2 into W and do the same for the
000012 CFDB F???      00149         movff   PLUSW2, ARGA1       ; other bytes in the input parameter
000016 0EFD           00150         movlw   0xFD
MPASM 5.54                      SQUAREROOT.S   3-13-2026  16:53:28         PAGE  4
16/32 bit Integer Square Root

