  VALUE

000018 CFDB F???      00151         movff   PLUSW2, ARGA2
00001C 0EFE           00152         movlw   0xFE
00001E CFDB F???      00153         movff   PLUSW2, ARGA3
000022 6700           00154         tstfsz  ARGA3, BANKED       ; determine if the number is 16-bit
000024 D???           00155         bra     Sqrt32              ; or 32-bit and call the best function
000026 6700           00156         tstfsz  ARGA2, BANKED
000028 D???           00157         bra     Sqrt32
                      00158                                     ; Fallthrough to Sqrt16
                      00159 
                      00160 ; *******************************************************************
                      00161 ; ******************** Square Root **********************************
                      00162 ; Sqrt16(ARGA1:ARGA0) = PRODL
00002A                00163 Sqrt16  
00002A 6B00           00164         clrf    TEMP0, BANKED       ; clear the temp solution
00002C 0E80           00165         movlw   0x80                ; setup the first bit
00002E 6F00           00166         movwf   BITLOC0, BANKED
000030 6F00           00167         movwf   RES0, BANKED
000032 5100           00168 Square8 movf    RES0, W, BANKED     ; square the guess
000034 0300           00169         mulwf   RES0, BANKED
000036 50F3           00170         movf    PRODL, W, ACCESS    ; ARGA - PROD test
000038 5D00           00171         subwf   ARGA0, W, BANKED
00003A 50F4           00172         movf    PRODH, W, ACCESS
00003C 5900           00173         subwfb  ARGA1, W, BANKED
00003E B0D8           00174         btfsc   STATUS, C, ACCESS
000040 D???           00175         bra     NextBit             ; if positive then next bit
                      00176                                     ; if negative then rotate right
000042 C??? F???      00177         movff   TEMP0, RES0         ; move last good value back into RES0
000046 4300           00178         rrncf   BITLOC0, F, BANKED  ; then rotote the bit and put it
000048 5100           00179         movf    BITLOC0, W, BANKED  ; back into RES0
00004A 1300           00180         iorwf   RES0, F, BANKED
00004C BF00           00181         btfsc   BITLOC0, 7, BANKED  ; if last value was tested then get
00004E D???           00182         bra     Done                ; out
000050 D???           00183         bra     Square8             ; elso go back for another test
000052 C??? F???      00184 NextBit movff   RES0, TEMP0         ; copy the last good approximation
000056 4300           00185         rrncf   BITLOC0, F, BANKED  ; rotate the bit location register
000058 5100           00186         movf    BITLOC0, W, BANKED
00005A 1300           00187         iorwf   RES0, F, BANKED
00005C BF00           00188         btfsc   BITLOC0, 7, BANKED  ; if last value was tested then get
00005E D???           00189         bra     Done                ; out
000060 D???           00190         bra     Square8
000062 C??? FFF3      00191 Done    movff   TEMP0,PRODL         ; put the final result in PRODL
000066 6AF4           00192         clrf    PRODH, ACCESS       ; clear out upper byte to be nice
000068 52E5           00193         movf    0xe5, 0x1, 0x0
00006A CFE7 FFD9      00194         movff   0xfe7, 0xfd9
00006E 0012           00195         return
                      00196 
                      00197 ; *******************************************************************
                      00198 ; ******************** Square Root **********************************
                      00199 ; Sqrt32(ARGA3:ARGA2:ARGA1:ARGA0) = PRODH:PRODL
000070                00200 Sqrt32  
000070 6B00           00201         clrf    TEMP0, BANKED       ; clear the temp solution
000072 6B00           00202         clrf    TEMP1, BANKED
000074 6B00           00203         clrf    BITLOC0, BANKED     ; setup the first bit
