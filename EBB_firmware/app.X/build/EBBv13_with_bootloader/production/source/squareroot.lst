00007C 6F00           00207         movwf   RES1, BANKED        ; RES = 0x8000
00007E C??? F???      00208 Squar16 movff   RES0, ARG1L         ; square the guess
000082 C??? F???      00209         movff   RES1, ARG1H
000086 EC?? F???      00210         call    Sq16
00008A 5100           00211         movf    SQRES0, W, BANKED   ; ARGA - PROD test
00008C 5D00           00212         subwf   ARGA0, W, BANKED
00008E 5100           00213         movf    SQRES1, W, BANKED
000090 5900           00214         subwfb  ARGA1, W, BANKED
000092 5100           00215         movf    SQRES2, W, BANKED
000094 5900           00216         subwfb  ARGA2, W, BANKED
000096 5100           00217         movf    SQRES3, W, BANKED
000098 5900           00218         subwfb  ARGA3, W, BANKED
00009A B0D8           00219         btfsc   STATUS, C, ACCESS
00009C D???           00220         bra     NxtBt16             ; if positive then next bit
                      00221                                     ; if negative then rotate right
00009E 0F00           00222         addlw   0x00                ; clear carry
0000A0 C??? F???      00223         movff   TEMP0, RES0         ; move last good value back into RES0
0000A4 C??? F???      00224         movff   TEMP1, RES1
0000A8 3300           00225         rrcf    BITLOC1, F, BANKED  ; then rotote the bit and put it
0000AA 3300           00226         rrcf    BITLOC0, F, BANKED
0000AC 5100           00227         movf    BITLOC1, W, BANKED  ; back into RES1:RES0
0000AE 1300           00228         iorwf   RES1, F, BANKED
0000B0 5100           00229         movf    BITLOC0, W, BANKED
0000B2 1300           00230         iorwf   RES0, F, BANKED
0000B4 B0D8           00231         btfsc   STATUS, C, ACCESS   ; if last value was tested then get
0000B6 D???           00232         bra     Done32              ; out
0000B8 D???           00233         bra     Squar16             ; elso go back for another test
0000BA 0F00           00234 NxtBt16 addlw   0x00                ; clear carry
0000BC C??? F???      00235         movff   RES0, TEMP0         ; copy the last good approximation
0000C0 C??? F???      00236         movff   RES1, TEMP1
0000C4 3300           00237         rrcf    BITLOC1, F, BANKED  ; rotate the bit location register
0000C6 3300           00238         rrcf    BITLOC0, F, BANKED
0000C8 5100           00239         movf    BITLOC1, W, BANKED  ; and put back into RES1:RES0
0000CA 1300           00240         iorwf   RES1, F, BANKED
0000CC 5100           00241         movf    BITLOC0, W, BANKED
0000CE 1300           00242         iorwf   RES0, F, BANKED
0000D0 B0D8           00243         btfsc   STATUS, C, ACCESS   ; if last value was tested then get
0000D2 D???           00244         bra     Done32              ; out
0000D4 D???           00245         bra     Squar16
0000D6 C??? FFF3      00246 Done32  movff   TEMP0,PRODL         ; put the final result in PRODL:PRODH
0000DA C??? FFF4      00247         movff   TEMP1,PRODH
0000DE 52E5           00248         movf    0xe5, 0x1, 0x0
0000E0 CFE7 FFD9      00249         movff   0xfe7, 0xfd9
0000E4 0012           00250         return
                      00251 
