                      00003 ; When assembly code is placed in a psect, it can be manipulated as a
                      00004 ; whole by the linker and placed in memory.  
                      00005 ;
                      00006 ; In this example, barfunc is the program section (psect) name, 'local' means
                      00007 ; that the section will not be combined with other sections even if they have
                      00008 ; the same name.  class=CODE means the barfunc must go in the CODE container.
                      00009 ; PIC18 should have a delta (addressible unit size) of 1 (default) since they
                      00010 ; are byte addressible.  PIC10/12/16 have a delta of 2 since they are word
                      00011 ; addressible.  PIC18 should have a reloc (alignment) flag of 2 for any
                      00012 ; psect which contains executable code.  PIC10/12/16 can use the default
                      00013 ; reloc value of 1.  Use one of the psects below for the device you use:
                      00014 
                      00015 ; psect   barfunc,local,class=CODE,delta=2 ; PIC10/12/16
                      00016 ;;;psect   barfunc,local,class=CODE,reloc=2 ; PIC18
                      00017 
                      00018 ;;;global _bar ; extern of bar function goes in the C source file
                      00019 ;;;_bar:
                      00020 ;;;    movf PORTA,w    ; here we use a symbol defined via xc.inc
                      00021 ;;;    return
