007d38   0e00     MOVLW     0x0                                                                                             
007d3a   da15     RCALL     0x8166                                                                                          
007d3c   d9cb     RCALL     0x80d4             gRC2RPn[i] = 0;                                                              D:\Projects\EggBot1-GH\EBB_firmware\app.X\source\RCServo2.c
007d3e   6aef     CLRF      0xef,0x0                                                                                        
