0074c6   52ee     MOVF      0xee,0x1,0x0                                                                                    
0074c8   6aef     CLRF      0xef,0x0                                                                                        
0074ca   dbd0     RCALL     0x7c6c                         pBDTEntryIn[0]->STAT.Val = _USIE|_DAT1|(_DTSEN & _DTS_CHECKING_ENABLED);         D:\Projects\EggBot1-GH\EBB_firmware\Microchip\USB\usb_device.c
0074cc   0ec8     MOVLW     0xc8                                                                                            
0074ce   6eef     MOVWF     0xef,0x0                                                                                        
                                                       }                                                                    D:\Projects\EggBot1-GH\EBB_firmware\Microchip\USB\usb_device.c
0074d0   0012     RETURN    0x0                        else if(controlTransferState == CTRL_TRF_TX)                         D:\Projects\EggBot1-GH\EBB_firmware\Microchip\USB\usb_device.c
