002ff2   f020                                                                                                               
002ff4   c100     MOVFF     0x100,0x4d       ebb_print_int(ISR_A_FIFO[0]);                                                  D:\Projects\EggBot1-GH\EBB_firmware\app.X\source\ebb.c
