0083c2   0e61     MOVLW     0x61                                                                                            
0083c4   26e9     ADDWF     0xe9,0x1,0x0                                                                                    
0083c6   0e00     MOVLW     0x0                                                                                             
0083c8   da15     RCALL     0x87f4                                                                                          
0083ca   d9cb     RCALL     0x8762             gRC2RPn[i] = 0;                                                              D:\Projects\EggBot1-GH\EBB_firmware\app.X\source\RCServo2.c
0083cc   6aef     CLRF      0xef,0x0                                                                                        
0083ce   d9e3     RCALL     0x8796             gRC2Target[i] = 0;                                                           D:\Projects\EggBot1-GH\EBB_firmware\app.X\source\RCServo2.c
0083d0   0e79     MOVLW     0x79                                                                                            
0083d2   26e9     ADDWF     0xe9,0x1,0x0                                                                                    
0083d4   0e00     MOVLW     0x0                                                                                             
0083d6   da0e     RCALL     0x87f4                                                                                          
0083d8   d9de     RCALL     0x8796             gRC2Rate[i] = 0;                                                             D:\Projects\EggBot1-GH\EBB_firmware\app.X\source\RCServo2.c
0083da   0e89     MOVLW     0x89                                                                                            
0083dc   26e9     ADDWF     0xe9,0x1,0x0                                                                                    
0083de   0e00     MOVLW     0x0                                                                                             
0083e0   da09     RCALL     0x87f4                                                                                          
008796   6aea     CLRF      0xea,0x0                                                                                        
008798   34df     RLCF      0xdf,0x0,0x0                                                                                    
00879a   0bfe     ANDLW     0xfe                                                                                            
