                                                 // the accumulators and doesn't zero or negate them.                       D:\Projects\EggBot1-GH\EBB_firmware\app.X\source\ebb.c
0027d2   0101     MOVLB     0x1                  gClearAccs = 0;                                                            D:\Projects\EggBot1-GH\EBB_firmware\app.X\source\ebb.c
