007ebe   da0e     RCALL     0x82dc                                                                                          
007ec0   d9de     RCALL     0x827e             gRC2Rate[i] = 0;                                                             D:\Projects\EggBot1-GH\EBB_firmware\app.X\source\RCServo2.c
007ec2   0e89     MOVLW     0x89                                                                                            
007ec4   26e9     ADDWF     0xe9,0x1,0x0                                                                                    
007ec6   0e00     MOVLW     0x0                                                                                             
